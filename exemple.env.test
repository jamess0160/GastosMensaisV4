# Copie para .env.test. Sobrescreve o .env apenas no que muda nos testes: o restante das
# variaveis (DB_HOST, DB_LOGIN, DB_PASSWORD, JWT_SECRET, CONSTANTS_PATH...) vem do .env.

PORT=4100

# Importar o app em memoria sobe o socket.io junto (Utils/socket.ts escuta no import).
# 0 = porta efemera: evita EADDRINUSE contra o servidor de desenvolvimento ou outra suite.
SOCKETPORT=0

# "false" desliga a descriptografia; use "true" quando os valores do .env estiverem criptografados
IS_CRIPTED="true"

# Banco dedicado aos testes. O nome PRECISA conter "test": as migrations rodam com rollback
# completo a cada execucao e a trava do TestEnv existe para nao derrubar o banco de desenvolvimento.
DB_SCHEMA=""

# Preencha para rodar as mesmas suites contra um servidor ja em pe (modo end to end).
# Suba o servidor com o mesmo ambiente: NODE_ENV=test npx tsx index.ts
# TEST_BASE_URL="http://localhost:4100"
