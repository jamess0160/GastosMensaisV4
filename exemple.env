# A porta da API
PORT=4000

# A porta do socket
SOCKETPORT=4001

# Dados de conexão com o banco. Para mais informações, consulte a documentação do knex: https://knexjs.org/guide/#node-js
DB_CLIENT="mysql"
DB_HOST="localhost"
DB_LOGIN="root"
DB_PASSWORD=""
DB_SCHEMA="bancopadrao"
#DB_PORT=""

# Chave para gerar o token JWT
JWT_SECRET=""
CONSTANTS_PATH="/Utils/constants.json"
# WebAuthn / biometria. O rpID e a origin sao exatamente o que o autenticador confere antes
# de assinar: valor errado, nenhuma assinatura passa. rpID e so o dominio (sem https:// e sem
# porta); WEBAUTHN_ORIGIN aceita lista separada por virgula (app web e app nativo).
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Gastos Mensais"
WEBAUTHN_ORIGIN="https://localhost:3000"
