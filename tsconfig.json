{
    "ts-node": {
        "require": [
            "tsconfig-paths/register"
        ]
    },
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "rootDir": ".",
        "baseUrl": ".",
        "outDir": "build",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "root/*": [
                "./*"
            ],
            "_Base/*": [
                "modules/_Base/*"
            ],
        }
    },
}