{
    "name": "gastos-mensais-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@simplewebauthn/browser": "^13.3.0",
        "@tanstack/react-query": "^5.62.7",
        "axios": "^1.20.0",
        "echarts": "^6.1.0",
        "lucide-react": "^1.38.0",
        "moment": "^2.30.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.28.0"
    },
    "devDependencies": {
        "@types/node": "^26.4.0",
        "@types/react": "^18.3.17",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "jsdom": "^29.1.1",
        "msw": "^2.15.0",
        "prettier": "^3.9.6",
        "typescript": "^5.7.2",
        "vite": "^6.0.3",
        "vitest": "^4.1.11"
    }
}
