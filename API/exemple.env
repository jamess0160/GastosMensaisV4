# O AMBIENTE - e a unica variavel que diz qual e. Em desenvolvimento ela fica de fora: a
# ausencia dela E a resposta "nao e producao nem teste", nao um erro de boot.
#
# Ela nao sai deste arquivo, e nao pode sair: o dotenv so e lido DEPOIS que alguem ja
# perguntou qual e o ambiente, para decidir se o .env.test entra por cima. O valor vem do
# terminal (cross-env, nos scripts do package.json) ou do orquestrador do deploy.
#
# NODE_ENV=production liga o `secure` no cookie de sessao - sem ela o cookie sai sem Secure
#   mesmo em https - e tira o stack de erro do stdout do container.
# NODE_ENV=test liga o .env.test por cima deste arquivo, o jsonTransport do Mailer (nada sai
#   pela rede) e desliga o motor de rotinas.
#
# Quem responde as duas perguntas e o Utils/environment.ts, e ninguem mais compara NODE_ENV na
# mao. Havia uma segunda variavel dizendo a mesma coisa - PROD, que so o AsyncHandler conhecia
# e nao estava documentada em lugar nenhum: ela nao existe mais.
#NODE_ENV="production"

# O FUSO DO PROCESSO - a variavel que ninguem tinha escrito, e cujo erro nao da erro.
#
# Utils.currentMonth() le o mes corrente do RELOGIO DO PROCESSO, e esse mes e o valor padrao de
# tres rotas: o saldo das contas (GET /Accounts), o relatorio do mes e o extrato. Num container
# em UTC - o padrao de toda imagem Docker - das 21h as 23h59 do ultimo dia do mes, no horario de
# Brasilia, as tres respondem sobre o MES SEGUINTE: o usuario abre o app as dez da noite do dia
# 31 e ve o saldo de um mes que ainda nao comecou, com o extrato vazio. Nada da erro, nada vai
# para o log, e o numero na tela esta errado.
#
# Ela tambem nao sai deste arquivo, pelo mesmo motivo do NODE_ENV so que mais cedo ainda: o fuso
# e lido pela libc no INICIO DO PROCESSO, muito antes de qualquer dotenv. Uma linha TZ aqui
# seria lida tarde demais para mudar o relogio que o moment ja enxerga. O valor vem do
# orquestrador - no deploy, do `environment:` do docker-compose.yml, ao lado do NODE_ENV.
#
# E ela DEPENDE DO tzdata DA IMAGEM. Sem o pacote instalado (o API/Dockerfile o instala por
# causa disto), a libc nao acha o arquivo do fuso e IGNORA O VALOR EM SILENCIO: o processo
# continua em UTC com a variavel ali, aparentemente certa. Por isso a prova e um comando e nao
# uma leitura - `docker compose exec api date` tem de dizer -03.
#TZ="America/Sao_Paulo"

# A porta da API
PORT=4000

# Dados de conexão com o banco. Para mais informações, consulte a documentação do knex: https://knexjs.org/guide/#node-js
#
# Em producao DB_HOST e "db": o nome do servico no docker-compose.yml, resolvido pelo DNS
# interno da rede do compose. O Postgres nao publica porta nenhuma no host, entao "localhost"
# la dentro nao alcanca banco nenhum.
#
# DB_LOGIN, DB_PASSWORD e DB_SCHEMA sao TAMBEM o POSTGRES_USER, o POSTGRES_PASSWORD e o
# POSTGRES_DB do servico `db` - o compose interpola as tres a partir do .env da raiz, para nao
# existir um segundo par de credenciais que alguem precise lembrar de manter igual.
DB_CLIENT="pg"
DB_HOST="localhost"
DB_LOGIN="root"
DB_PASSWORD=""
DB_SCHEMA="bancopadrao"
#DB_PORT=""

# Chave para gerar o token JWT. Em producao gere uma NOVA, no servidor:
#
#   openssl rand -base64 48
#
# Nunca a de desenvolvimento. O token e assinado com ela e carrega a sessao inteira (IdUser e
# IdWorkspace), entao um segredo compartilhado entre as duas maquinas faz um token emitido na
# sua maquina valer em producao. Ela tambem assina o link de recuperacao de senha e o desafio
# da biometria, que e o que impede os dois de serem escritos pelo cliente.
JWT_SECRET=""

# WebAuthn / biometria. O rpID e a origin sao exatamente o que o autenticador confere antes
# de assinar: valor errado, nenhuma assinatura passa. rpID e so o dominio (sem https:// e sem
# porta); WEBAUTHN_ORIGIN aceita lista separada por virgula (app web e app nativo).
#
# Em producao:
#   WEBAUTHN_RP_ID="gastosmensais.com.br"            (dominio nu - sem esquema, sem porta)
#   WEBAUTHN_ORIGIN="https://www.gastosmensais.com.br" (com o esquema, completo)
#
# O rpID e o dominio NU e nao o "www." de proposito: ele pode ser o dominio registravel do qual
# a origem e subdominio, e assim a mesma passkey vale no apex e no www. Errar qualquer um dos
# dois NAO da erro - a biometria simplesmente nao funciona, e quem cadastrou a digital descobre
# na hora de usar.
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Gastos Mensais"
WEBAUTHN_ORIGIN="https://localhost:3000"

# Envio de e-mail. O transporte e criado na PRIMEIRA vez que alguem manda um e-mail, nao no
# boot: um ambiente sem SMTP configurado continua subindo a API, e a falta so aparece como
# linha de log quando um envio for tentado. Em NODE_ENV=test nada disso e lido - a suite usa o
# jsonTransport do nodemailer, e nada sai pela rede.
MAIL_SMTP="smtp.exemplo.com.br"
MAIL_SMTP_PORT="587"
# "true" na porta 465 (TLS desde o primeiro byte). Na 587 fica "false", e o STARTTLS passa a
# ser exigido - nunca desligue a cifra: o corpo de um e-mail de recuperacao E a credencial.
MAIL_SMTP_SECURE="false"
MAIL_USER="nao-responda@gastosmensais.com.br"
MAIL_PASSWORD=""
# O remetente NAO e o login do SMTP: o provedor exige um endereco autorizado, e a caixa de
# entrada mostra este texto. Formato completo, com nome.
MAIL_FROM="Gastos Mensais <nao-responda@gastosmensais.com.br>"

# A URL PUBLICA DO FRONT - a variavel que se esquece. Todo e-mail carrega um link, e sem ela
# alguem monta o link com o Host da requisicao: um Host forjado vira um link de recuperacao de
# senha apontando para o servidor de outra pessoa, com o token dentro.
#
# Aponta para o FRONT, nunca para a API: a tela e que chama o POST correspondente, o que impede
# o e-mail de virar um GET que muda estado.
#
# O valor abaixo ja e o de producao - o dominio final, com https. Em desenvolvimento troque pelo
# endereco do servidor do Vite; e o unico lugar em que esta variavel aparece na tela do usuario,
# porque ela E o link que ele clica.
APP_URL="https://www.gastosmensais.com.br"
