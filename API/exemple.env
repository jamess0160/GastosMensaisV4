# O AMBIENTE - e a unica variavel que diz qual e. Em desenvolvimento ela fica de fora: a
# ausencia dela E a resposta "nao e producao nem teste", nao um erro de boot.
#
# Ela nao sai deste arquivo, e nao pode sair: o dotenv so e lido DEPOIS que alguem ja
# perguntou qual e o ambiente, para decidir se o .env.test entra por cima. O valor vem do
# terminal (cross-env, nos scripts do package.json) ou do orquestrador do deploy.
#
# NODE_ENV=production liga o `secure` no cookie de sessao - sem ela o cookie sai sem Secure
#   mesmo em https - e tira o stack de erro do stdout do container.
# NODE_ENV=test liga o .env.test por cima deste arquivo, o jsonTransport do Mailer (nada sai
#   pela rede) e desliga o motor de rotinas.
#
# Quem responde as duas perguntas e o Utils/environment.ts, e ninguem mais compara NODE_ENV na
# mao. Havia uma segunda variavel dizendo a mesma coisa - PROD, que so o AsyncHandler conhecia
# e nao estava documentada em lugar nenhum: ela nao existe mais.
#NODE_ENV="production"

# A porta da API
PORT=4000

# Dados de conexão com o banco. Para mais informações, consulte a documentação do knex: https://knexjs.org/guide/#node-js
DB_CLIENT="pg"
DB_HOST="localhost"
DB_LOGIN="root"
DB_PASSWORD=""
DB_SCHEMA="bancopadrao"
#DB_PORT=""

# Chave para gerar o token JWT
JWT_SECRET=""

# WebAuthn / biometria. O rpID e a origin sao exatamente o que o autenticador confere antes
# de assinar: valor errado, nenhuma assinatura passa. rpID e so o dominio (sem https:// e sem
# porta); WEBAUTHN_ORIGIN aceita lista separada por virgula (app web e app nativo).
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="Gastos Mensais"
WEBAUTHN_ORIGIN="https://localhost:3000"

# Envio de e-mail. O transporte e criado na PRIMEIRA vez que alguem manda um e-mail, nao no
# boot: um ambiente sem SMTP configurado continua subindo a API, e a falta so aparece como
# linha de log quando um envio for tentado. Em NODE_ENV=test nada disso e lido - a suite usa o
# jsonTransport do nodemailer, e nada sai pela rede.
MAIL_SMTP="smtp.exemplo.com.br"
MAIL_SMTP_PORT="587"
# "true" na porta 465 (TLS desde o primeiro byte). Na 587 fica "false", e o STARTTLS passa a
# ser exigido - nunca desligue a cifra: o corpo de um e-mail de recuperacao E a credencial.
MAIL_SMTP_SECURE="false"
MAIL_USER="nao-responda@gastosmensais.com.br"
MAIL_PASSWORD=""
# O remetente NAO e o login do SMTP: o provedor exige um endereco autorizado, e a caixa de
# entrada mostra este texto. Formato completo, com nome.
MAIL_FROM="Gastos Mensais <nao-responda@gastosmensais.com.br>"

# A URL PUBLICA DO FRONT - a variavel que se esquece. Todo e-mail carrega um link, e sem ela
# alguem monta o link com o Host da requisicao: um Host forjado vira um link de recuperacao de
# senha apontando para o servidor de outra pessoa, com o token dentro.
#
# Aponta para o FRONT, nunca para a API: a tela e que chama o POST correspondente, o que impede
# o e-mail de virar um GET que muda estado.
APP_URL="https://www.gastosmensais.com.br"
