# Copie para .env.test. Sobrescreve o .env apenas no que muda nos testes: o restante das
# variaveis (DB_HOST, DB_LOGIN, DB_PASSWORD, JWT_SECRET...) vem do .env.
#
# NODE_ENV nao se declara aqui: e ela que decide se este arquivo e carregado, e o dotenv roda
# depois dessa pergunta. Ela vem do terminal - o cross-env dos scripts de teste do
# package.json, ou o TestEnv, que a define antes de importar qualquer modulo do app.

PORT=4100

# Banco dedicado aos testes. O nome PRECISA conter "test": as migrations rodam com rollback
# completo a cada execucao e a trava do TestEnv existe para nao derrubar o banco de desenvolvimento.
DB_SCHEMA=""

# Preencha para rodar as mesmas suites contra um servidor ja em pe (modo end to end).
# Suba o servidor com o mesmo ambiente: NODE_ENV=test npx tsx index.ts
# TEST_BASE_URL="http://localhost:4100"

# Opcional: o TestEnv ja define um APP_URL de teste quando ele nao existe, e as MAIL_* nunca
# sao lidas em NODE_ENV=test (o Mailer usa o jsonTransport). Declare APP_URL aqui so se quiser
# afirmar outro dominio nos links dos e-mails.
# APP_URL="https://app.gastos.local"
